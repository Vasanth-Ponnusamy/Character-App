@model CharacterViewModel

<h2>Create New Character</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label for="Name">Name</label>
        <input type="text" id="Name" name="Name" class="form-control" value="@Model.Name" required />
    </div>
    <div class="form-group">
        <label for="Species">Species</label>
        @* @Html.DropDownListFor(model => model.Species, (SelectList)ViewBag.SpeciesList, "Select Species", new { @class = "form-control" }) *@
        <input type="text" id="Species" name="Species" class="form-control" value="@Model.Species" required />
    </div>

    <div class="form-group">
        <label for="Gender">Gender</label>
        @* @Html.DropDownListFor(model => model.Gender, (SelectList)ViewBag.GenderList, "Select Gender", new { @class = "form-control" }) *@
        <input type="text" id="Gender" name="Gender" class="form-control" value="@Model.Gender" required />
    </div>

    <div class="form-group">
        <label for="LocationId">Location</label>
        @Html.DropDownListFor(model => model.LocationId, (SelectList)ViewBag.Locations, "Select Location", new { @class = "form-control" })
        @Html.ValidationMessageFor(model => model.LocationId, "", new { @class = "text-danger" })
    </div>
    <div class="form-group">
        <label for="LocationId">Origin</label>
        @Html.DropDownListFor(model => model.OriginId, (SelectList)ViewBag.Locations, "Select Origin", new { @class = "form-control" })
    </div>
    <div class="form-group">
        <label for="Episodes">Episodes</label>
        @Html.ListBoxFor(model => model.Episodes, (SelectList)ViewBag.Episodes, new { @class = "form-control", multiple = "multiple" })
    </div>

    <div class="form-group mt-3">
    <button type="submit" class="btn btn-primary">Create Character</button>
    </div>
</form>

